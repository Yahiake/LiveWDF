  ],
  "description": "Four EQ stages from the Gold Label BA312 assembly, EX10312, using the discrete EX10338 BA338 cards, cumulative treble and bass capacitor banks, two switched presence coils with high-Q settings, and shelf/peak selectors. Coil taps are represented by measured individual equivalent inductances and resistance. Third-order cut filters preserve the published settings and slopes using linear voltage followers. Transistor types use documented silicon or germanium-family substitutes. The standalone line connection omits the microphone preamp, fader, relay drive and line transformer. Each gain control acts after engaging a frequency detent. When multiple detents are active, the last enabled position in the selector order takes precedence.",
  "groundNode": "0",
  "inputNode": "in",
  "layout": {
    "pots": [
      "Treble Gain",
      "Upper Presence Gain",
      "Lower Presence Gain",
      "Bass Gain"
    ],
    "switches": [
      "Low Cut Enable",
      "Low Cut 47 Hz",
      "Low Cut 82 Hz",
      "Low Cut 150 Hz",
      "Low Cut 270 Hz",
      "High Cut Enable",
      "High Cut 12 kHz",
      "High Cut 8.2 kHz",
      "High Cut 5.6 kHz",
      "High Cut 3.9 kHz",
      "Treble 15 kHz",
      "Treble 10 kHz",
      "Treble 6.8 kHz",
      "Treble 4.7 kHz",
      "Treble 3.3 kHz",
      "Treble Bell",
      "Upper Presence 1.5 kHz",
      "Upper Presence 1.8 kHz",
      "Upper Presence 2.2 kHz",
      "Upper Presence 2.7 kHz",
      "Upper Presence 3.3 kHz",
      "Upper Presence 3.9 kHz",
      "Upper Presence 4.7 kHz",
      "Upper Presence 5.6 kHz",
      "Upper Presence 6.8 kHz",
      "Upper Presence 8.2 kHz",
      "Upper Presence Hi Q",
      "Lower Presence 220 Hz",
      "Lower Presence 270 Hz",
      "Lower Presence 330 Hz",
      "Lower Presence 390 Hz",
      "Lower Presence 470 Hz",
      "Lower Presence 560 Hz",
      "Lower Presence 680 Hz",
      "Lower Presence 820 Hz",
      "Lower Presence 1 kHz",
      "Lower Presence 1.2 kHz",
      "Lower Presence Hi Q",
      "Bass 330 Hz",
      "Bass 180 Hz",
      "Bass 100 Hz",
      "Bass 56 Hz",
      "Bass 33 Hz",
      "Bass Bell",
      "EQ Bypass"
    ]
  },
