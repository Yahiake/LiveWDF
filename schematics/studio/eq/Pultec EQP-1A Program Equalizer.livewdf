  ],
  "description": "Pultec EQP-1A passive equalizer and EQP-1A3 dual-triode makeup amplifier (drawing E-72,658-3). Includes the interacting bass boost and attenuation bridge, independent treble controls, switched resonators, 12AX7 and 12AU7 push-pull stages, transformer line connections and feedback winding. The linear coil and transformer parasitics are estimates, and the tertiary feedback winding is represented with an auxiliary transformer. The highest engaged frequency switch in each band wins, with the lowest frequency chosen when all are off. The tube rectifier and heater supply are represented by the nominal B+ rail.",
  "groundNode": "0",
  "inputNode": "in",
  "layout": {
    "pots": [
      "Low Boost",
      "Low Attenuation",
      "High Boost",
      "High Bandwidth",
      "High Attenuation"
    ],
    "switches": [
      "Low Frequency 30 Hz",
      "Low Frequency 60 Hz",
      "Low Frequency 100 Hz",
      "High Boost 4 kHz",
      "High Boost 5 kHz",
      "High Boost 8 kHz",
      "High Boost 10 kHz",
      "High Boost 12 kHz",
      "High Boost 16 kHz",
      "High Attenuation 10 kHz",
      "High Attenuation 20 kHz",
      "EQ Bypass"
    ]
  },
  "name": "Pultec EQP-1A Program Equalizer",
  "outputNode": "out",
  "version": 3,
