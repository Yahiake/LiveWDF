  ],
  "description": "The four-band proportional-Q equalizer and separate sweepable high-pass/low-pass filters of the Harrison 3232 input/output card, PC1003-A Rev 3. The original low band is switchable shelving/bell. This revision uses a fixed peaking high band. The EQ and HP/LP inserts are separately selectable as on the console. HA4605/HA4741 quad amplifier sections use LM741-class device models at the documented ±18 V rails. This mono line-level sheet excludes the mic input, monitor, send and fader circuits.",
  "groundNode": "0",
  "inputNode": "in",
  "layout": {
    "pots": [
      "High Pass Frequency",
      "Low Pass Frequency",
      "Low Gain",
      "Low Frequency",
      "Low Mid Gain",
      "Low Mid Frequency",
      "High Mid Gain",
      "High Mid Frequency",
      "High Gain",
      "High Frequency"
    ],
    "switches": [
      "HP/LP Filters In",
      "Low Bell",
      "EQ In"
    ]
  },
  "name": "Harrison 32-Series 3232 Channel EQ",
  "outputNode": "out",
