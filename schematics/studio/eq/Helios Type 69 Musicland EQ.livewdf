  ],
  "description": "Line-input equalizer path of the Musicland Type 69 and modern IA-H9 tracing. Includes the transistor-buffered high-pass, four switched bass boost frequencies, independent 50 Hz attenuation, eight LC mid peaks or troughs, stepped 10 kHz shelf, EQ bypass and 2128 three-transistor makeup. BC109C stands in for the high-gain NPN parts and fixed inductance models stand in for the selected taps. Some coil and capacitor values use the documented IA-H9 equivalent. Highest enabled frequency or attenuation takes precedence, and bass attenuation deselects bass boost. The microphone transformer and preamplifier are outside this line-path model.",
  "groundNode": "0",
  "inputNode": "in",
  "layout": {
    "pots": [
      "Bass Boost",
      "Mid Gain"
    ],
    "switches": [
      "High Pass 40 Hz",
      "High Pass 80 Hz",
      "Bass Boost 60 Hz",
      "Bass Boost 120 Hz",
      "Bass Boost 250 Hz",
      "Bass Boost 400 Hz",
      "Bass Attenuation 3 dB",
      "Bass Attenuation 6 dB",
      "Bass Attenuation 9 dB",
      "Bass Attenuation 12 dB",
      "Bass Attenuation 15 dB",
      "Mid 1 kHz",
      "Mid 1.4 kHz",
      "Mid 2 kHz",
      "Mid 2.8 kHz",
      "Mid 3.5 kHz",
      "Mid 4.5 kHz",
      "Mid 6 kHz",
      "Mid Trough",
      "Treble 2 dB",
      "Treble 4 dB",
      "Treble 6 dB",
      "Treble 8 dB",
      "Treble 10 dB",
      "Treble Cut",
      "EQ Bypass"
    ]
  },
  "name": "Helios Type 69 Musicland EQ",
  "outputNode": "out",
  "version": 3,
