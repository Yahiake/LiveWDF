  ],
  "description": "Pultec MEQ-5 passive mid-range equalizer with five low boost, eleven dip and five high boost settings and the E-301,461-1 tube amplifier. Uses the published tapped-inductor values with individual switched series branches and nominal-frequency capacitor estimates where passive redraws disagree with the panel settings. A Koren 6V6S model stands in for the triode-strapped 6AQ5. Linear transformer parasitics are estimates and the rectifier and heaters are represented by a nominal B+ supply. The highest engaged frequency switch in each band takes precedence, with the lowest frequency selected when all are off. EQ Bypass leaves the tube amplifier in circuit.",
  "groundNode": "0",
  "inputNode": "in",
  "layout": {
    "pots": [
      "Low Mid Boost",
      "Mid Dip",
      "High Mid Boost"
    ],
    "switches": [
      "Low Boost 300 Hz",
      "Low Boost 500 Hz",
      "Low Boost 700 Hz",
      "Low Boost 1000 Hz",
      "High Boost 2000 Hz",
      "High Boost 3000 Hz",
      "High Boost 4000 Hz",
      "High Boost 5000 Hz",
      "Mid Dip 300 Hz",
      "Mid Dip 500 Hz",
      "Mid Dip 700 Hz",
      "Mid Dip 1000 Hz",
      "Mid Dip 1500 Hz",
      "Mid Dip 2000 Hz",
      "Mid Dip 3000 Hz",
      "Mid Dip 4000 Hz",
      "Mid Dip 5000 Hz",
      "Mid Dip 7000 Hz",
      "EQ Bypass"
    ]
  },
  "name": "Pultec MEQ-5 Mid-Range Equalizer",
