  ],
  "description": "Four-band equaliser core, drawing T82242-70 assembly rev 5, active between console pins 48 and 43. Two cross-coupled summing stages, four two-op-amp filters, continuously linked frequency and Q controls and linked LF/HF bell switches. NE5532 cards stand in for NE5534N, three-terminal gain pots for center-tapped controls, and resistive switches for the J112 shunts. Console routing, overload circuitry and separately switched end-cut filters are omitted.",
  "groundNode": "0",
  "inputNode": "in",
  "layout": {
    "pots": [
      "LF Gain",
      "LF Frequency",
      "LMF Gain",
      "LMF Frequency",
      "LMF Q",
      "HMF Gain",
      "HMF Frequency",
      "HMF Q",
      "HF Gain",
      "HF Frequency"
    ],
    "switches": [
      "LF Bell",
      "HF Bell"
    ]
  },
  "name": "SSL 4000 E 82E242 Black EQ",
