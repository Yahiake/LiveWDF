  ],
  "description": "Single-ended line path of the Soundcraft S500/S600 standard mono input module, factory ED2162 revision 8. Includes the differential transistor preamp and DC servo, low-cut section, four-band EQ with both linked mid sweeps, EQ bypass and channel fader amplifier. The line source uses a 600 ohm source model, with J11 engaged for the +4 dBu line setting. TR1 and TR2 use the Fairchild 2N4403 card. The NE5532 card substitutes for the NE5534. The raw microphone connector, phantom supply, insert jack, buses and meters are outside this line-channel model.",
  "groundNode": "0",
  "inputNode": "in",
  "layout": {
    "pots": [
      "Input Trim",
      "High",
      "High Mid Frequency",
      "High Mid Gain",
      "Low Mid Frequency",
      "Low Mid Gain",
      "Low",
      "Channel Fader"
    ],
    "switches": [
      "+4 dBu Line",
      "Low Cut",
      "EQ Bypass"
    ]
  },
  "name": "Soundcraft Series 600 Mono Input",
  "outputNode": "out",
