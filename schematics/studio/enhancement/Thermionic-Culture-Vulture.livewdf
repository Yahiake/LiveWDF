{
  "version": 3,
  "name": "Thermionic Culture Vulture Model",
  "category": "Enhancement",
  "author": "LiveWDF",
  "description": "One channel of the original transformerless Culture Vulture reconstructed from Thermionic Culture\u2019s documentation and valve data. The EF86 drives a cathode-biased 6AS6 stage, with a strapped-screen triode mode, pentode mode, and an approximate dual-control P2 mode. The ganged Bias controls calibrate the modeled stage currents over the shared panel range. An equivalent 5963 output stage follows the selectable low-pass filters. Component values, P2 wiring and filter topology are estimated. The mains supply and meter are excluded.",
  "io": {
    "groundNode": "0",
    "inputNode": "in",
    "outputNode": "out"
  },
  "layout": {
    "pots": [
      "Drive",
      "Bias",
      "Output"
    ],
    "switches": [
      "Overdrive",
      "Pentode P1",
      "Pentode P2",
      "Low-pass 9 kHz",
      "Low-pass 5 kHz",
      "Bypass"
    ]
  },
