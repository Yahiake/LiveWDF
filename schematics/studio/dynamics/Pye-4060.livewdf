{
  "version": 3,
  "name": "Pye 4060 Average-Duty Limiter",
  "category": "Dynamics",
  "author": "LiveWDF",
  "description": "BBC 4060 architecture with input/output transformer equivalents and opposed, ganged threshold attenuators. A feedback rectifier and physical charge/decay network control the mean open duty of the documented transistor audio chopper. The audio-rate average avoids aliasing the 250 kHz carrier. The circuit is a baseband reconstruction from BBC operating notes, with equivalent amplifiers and calibrated component values.",
  "io": {
    "groundNode": "0",
    "inputNode": "in",
    "outputNode": "out"
  },
  "layout": {
    "pots": [
      "THRESH_IN",
      "THRESH_OUT",
      "RATIO",
      "DECAY"
    ],
    "switches": [
      "LIMIT",
      "ENGAGE",
      "BYPASS"
    ]
  },
