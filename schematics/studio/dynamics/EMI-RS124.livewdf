{
  "version": 3,
  "name": "EMI RS124",
  "category": "Dynamics",
  "author": "LiveWDF",
  "description": "EMI drawing RS124/D1/2 with the later 130 ohm cathode bias and 100 kilohm plate feedback. Uses fitted variable-mu 6BC8, 6CG7 and 6AL5 curves and the original output transformer configuration for the nominal 200 ohm attenuator. The continuous Recovery spans the original timing ladder and Hold opens its normal discharge path. The ganged input and stepped output attenuators use one control each. The neon balance oscillator, meter, stereo and remote relay wiring and mains are omitted.",
  "io": {
    "groundNode": "0",
    "inputNode": "in",
    "outputNode": "out"
  },
  "layout": {
    "pots": [
      "GAIN",
      "OUTLEV",
      "RECV"
    ],
    "switches": [
      "HOLD"
    ]
  },
