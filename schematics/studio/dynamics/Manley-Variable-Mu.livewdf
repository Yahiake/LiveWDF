{
  "version": 3,
  "name": "Manley Variable Mu 5670 Model",
  "category": "Dynamics",
  "author": "LiveWDF",
  "description": "One transformer-coupled, balanced Vari-Mu lane reconstructed from Manley\u2019s 5670 service documentation. Paired 5670 gain stages, 12AX7 drivers, 5687 output tubes and a 12AL5 space-charge detector equivalent retain valve operation. The two compression modes share a physical attack and recovery network. Component and transformer values are estimated from published valve curves and device specifications. Stereo linking and metering are excluded.",
  "io": {
    "groundNode": "0",
    "inputNode": "in",
    "outputNode": "out"
  },
  "layout": {
    "pots": [
      "INPUT",
      "OUTPUT",
      "THRESH",
      "ATTACK",
      "RECOVERY"
    ],
    "switches": [
      "LIMIT",
      "COMPRESS",
      "BYPASS"
    ]
  },
