{
  "version": 3,
  "name": "API 2500 Bus Compressor Model",
  "category": "Dynamics",
  "author": "LiveWDF",
  "description": "One API 2500 lane reconstructed from the published signal-flow diagrams and control descriptions. It uses a Blackmer VCA, log RMS detector and RC timing, with switchable ahead-of-cell and feedback detection, three analog knee selections and two Thrust filter curves. The 2520 signal amplifiers and proprietary tone networks use equivalent stages. Stereo linking and the external detector input are outside this model.",
  "io": {
    "groundNode": "0",
    "inputNode": "in",
    "outputNode": "out"
  },
  "layout": {
    "pots": [
      "THRESH",
      "RATIO_FF",
      "RATIO_FB",
      "ATTACK",
      "RELEASE",
      "MAKEUP"
    ],
    "switches": [
      "OLD_TAP",
      "OLD_RATIO",
      "MED",
      "LOUD",
      "MEDK",
      "SOFTK",
      "BYPASS"
    ]
  },
