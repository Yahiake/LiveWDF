{
  "version": 3,
  "name": "Fairchild 660",
  "category": "Dynamics",
  "author": "LiveWDF",
  "description": "Factory Fairchild 660 single-channel variable-mu signal path. Four matched 6386 sections per half are lumped from GE curves. The feedback path uses separate 12AX7, 12BH7A and push-pull 6V6 stages, a transformer and negative diode bridge. Transformer data, balanced threshold drive and control timing are nominal equivalents. The timing network exposes continuous Release and a switchable program-dependent tail. Metering, regulator and mains are omitted.",
  "io": {
    "groundNode": "0",
    "inputNode": "in",
    "outputNode": "out"
  },
  "layout": {
    "pots": [
      "AT1",
      "R10A",
      "R10B",
      "RELEASE"
    ],
    "switches": [
      "TIMING"
    ]
  },
