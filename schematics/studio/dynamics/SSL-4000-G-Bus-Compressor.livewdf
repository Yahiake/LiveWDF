{
  "version": 3,
  "name": "SSL 4000 G Bus Compressor",
  "category": "Dynamics",
  "author": "LiveWDF",
  "description": "One signal lane of the SSL 4000 G master compressor, based on T82026 and T82027. The audio and sidechain use THAT2180 Blackmer equivalents, a precision full-wave detector and a physical RC timing network with Auto Release. The ratio switches select the calibrated sidechain gains above the soft knee. Threshold and Make-up retain separate control paths. A linked stereo detector, external patching, fader, meter and autofade circuits are outside this model.",
  "io": {
    "groundNode": "0",
    "inputNode": "in",
    "outputNode": "out"
  },
  "layout": {
    "pots": [
      "THRESH",
      "ATTACK",
      "RELEASE",
      "MAKEUP"
    ],
    "switches": [
      "RATIO",
      "LIMIT",
      "AUTO"
    ]
  },
