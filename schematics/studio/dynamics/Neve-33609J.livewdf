{
  "version": 3,
  "name": "Neve 33609/J Diode Bridge",
  "category": "Dynamics",
  "author": "LiveWDF",
  "description": "One channel based on Neve EX11475. A four-diode bridge and balanced pad lead through JFET buffers and transformer equivalents to the makeup and output stage. Compressor and limiter use independent feedback paths, thresholds and RC memories. The BA340-C signal stage and transistor detector amplifiers use bounded amplifier equivalents. Ratio and recovery controls are continuous. Stereo link, remote control, meters and power regulation are excluded.",
  "io": {
    "groundNode": "0",
    "inputNode": "in",
    "outputNode": "out"
  },
  "layout": {
    "pots": [
      "CTH",
      "CRATIO",
      "CREC",
      "LTH",
      "LREC",
      "MAKEUP"
    ],
    "switches": [
      "CENGAGE",
      "LENGAGE",
      "LFAST",
      "BYPASS"
    ]
  },
