{
  "version": 3,
  "name": "Gates Sta-Level M5167",
  "category": "Dynamics",
  "author": "LiveWDF",
  "description": "Gates C-19530 broadcast leveler, with the remote-cutoff GL-6386 gain pair, 12AT7 cathode-feedback driver, push-pull 6V6 line output and 6AL5 feedback rectifier. Fitted parallel current regions reproduce the 6386 curves. The center-tapped windings use nominal ratios and the input and output attenuators use single-ended equivalents. Single and Double select the physical timing network. The Input trim models source level. Meter, heater, regulator and mains are outside the model.",
  "io": {
    "groundNode": "0",
    "inputNode": "in",
    "outputNode": "out"
  },
  "layout": {
    "pots": [
      "INLEV",
      "OUTLEV"
    ],
    "switches": [
      "S1"
    ]
  },
