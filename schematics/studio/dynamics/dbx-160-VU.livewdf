{
  "version": 3,
  "name": "dbx 160 VU",
  "category": "Dynamics",
  "author": "LiveWDF",
  "description": "Original dbx 160 VU, factory 160/161 M1 VCA 200 and M2 RMS 209 bill of materials. The 200 uses the complementary transistor-pair transfer of dbx drawing 110557 at fixed nominal supplies. Pi and No receive the gain command, Ni is grounded and Po takes the centered R25/R28 symmetry trim. The 209 is a calibrated current-input terminal model with negative log output and 22 \u00b5F timing, anchored at 1.228 Vrms, 100 Hz. OA3 output is \u221211 mV at that point. The patent-derived RMS averaging law and 120 dB/s release rate govern the detector. Internal 209 transistor values, amplifier and meter trim offsets, the muting circuit and thermal drift are omitted. The threshold/ratio stage is a hard-knee equivalent, the input cold lead is grounded, and the output sees 10 k\u03a9.",
  "io": {
    "groundNode": "0",
    "inputNode": "in",
    "outputNode": "out"
  },
  "layout": {
    "pots": [
      "THRESH",
      "RATIO",
      "GAIN"
    ]
  },
