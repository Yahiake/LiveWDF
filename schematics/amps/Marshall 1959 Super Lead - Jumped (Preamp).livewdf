{
  "version": 3,
  "name": "Marshall 1959 Super Lead - Jumped (Preamp)",
  "author": "LiveWDF",
  "category": "Amp",
  "description": "Jumped high-treble and normal channels from the 1981 Marshall Standard Lead drawing. Four ECC83 sections, bright bypasses and passive three-band EQ. Ends at the loaded phase-inverter feed.",
