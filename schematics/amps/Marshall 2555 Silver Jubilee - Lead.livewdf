  "description": "Silver Jubilee Lead path with asymmetric LED and silicon clipping, lead master, normalled effects loop and the ganged bass tone network. Includes the high-power pentode position of the 2555 STD output stage, four EL34s and Presence. The 4 Ω load and output transformer use estimated winding parameters.",
  "io": {
    "groundNode": "0",
    "inputNode": "in",
    "outputNode": "out"
  },
  "layout": {
    "pots": [
      "Input Gain",
      "Lead Master",
      "Treble",
      "Middle",
      "Bass",
      "Output Master",
      "Presence"
    ]
  },
