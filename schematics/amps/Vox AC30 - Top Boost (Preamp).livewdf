{
  "version": 3,
  "name": "Vox AC30 - Top Boost (Preamp)",
  "author": "LiveWDF",
  "category": "Amp",
  "description": "Brilliant input from Jennings OS/065 with the OS/010 Top Boost add-on. Includes the shared input-stage cathode, added ECC83 gain and follower stages, and interactive Bass and Treble. Ends at the loaded phase-inverter feed with the other channels closed.",
