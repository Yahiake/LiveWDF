  ],
  "description": "Engaged GE-7 signal path with six gyrator bands, one high shelf and Level. Based on the February 1987 service notes and Jon Hilderson redraw. IC1 uses a JRC4558 proxy for HA1457W; Q6 uses a 2N3904 proxy for 2SC732TM-GR. The band sliders include 4.7 ohm end-contact resistances. Electronic bypass switching and indicator are omitted.",
  "groundNode": "0",
  "inputNode": "in",
  "layout": {
    "pots": [
      "100 Hz",
      "200 Hz",
      "400 Hz",
      "800 Hz",
      "1.6 kHz",
      "3.2 kHz",
      "6.4 kHz",
      "Level"
    ]
  },
