  ],
  "description": "Based on the December 1996 PCB 70901390 TR-2 service drawing. The M5207L01 current-output VCA and Rate, Wave and Depth networks use the reference component values. Analog rail clamps and short Schmitt feedback filtering stabilize the comparator-integrator oscillator. A low-level startup perturbation supplies the offset present in hardware. The Tremolo switch represents the electronic bypass; LED and latch circuitry are omitted.",
  "io": {
    "groundNode": "0",
    "inputNode": "in",
    "outputNode": "out"
  },
  "layout": {
    "pots": [
      "Rate",
      "Wave",
      "Depth"
    ],
    "switches": [
      "Tremolo"
    ]
  },
  "name": "Boss TR-2 Tremolo",
