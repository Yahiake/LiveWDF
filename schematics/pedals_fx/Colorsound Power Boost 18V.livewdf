  ],
  "description": "Later 18 V Colorsound Power Boost, reconstructed from the stock configuration of the Swell Amps 1970 three-transistor boost schematic. The three BC109C transistors retain the collector feedback loop around Q1 and Q2 and the active Baxandall network around Q3. The later component set uses 10 µF at C4 and C12, and 220 nF at C13. The 10 kΩ linear Drive control changes emitter bypass resistance. The output sees a 1 MΩ amplifier input.",
  "groundNode": "0",
  "inputNode": "in",
  "layout": {
    "pots": [
      "Drive",
      "Bass",
      "Treble"
    ]
  },
  "name": "Colorsound Power Boost 18V",
  "outputNode": "out",
