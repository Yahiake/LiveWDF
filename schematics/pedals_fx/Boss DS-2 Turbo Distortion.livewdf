{
  "version": 3,
  "name": "Boss DS-2 Turbo Distortion",
  "category": "Distortion",
  "author": "Jegor van Opdorp",
  "description": "BOSS DS-2 service drawing, ET board 7510952000 and VR board 7510954000. Turbo I/II selects the Q14/Q15 pre-emphasis, Q20 feedback bypass and Q10 output notch together. The engaged effect retains the input and output buffers and the separately muted dry path. The switch channels use 60 ohms on and high resistance off, and the 8 V and 4 V rails are idealized. Q6/Q16/Q19 use the 2SK184-GR card. A 2SC2240 substitutes for each 2SC3378-GR, 2N3906 for Q17 (2SA1335-GR) and 1N34A for the early D14/D15 germanium pair. The D and G pot curves are approximated with log and linear tapers respectively.",
  "groundNode": "0",
  "inputNode": "in",
  "outputNode": "out",
  "layout": {
    "pots": [
      "Distortion",
      "Tone",
      "Level"
    ]
  },
