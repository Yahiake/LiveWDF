{
  "name": "Shin-ei Univox Uni-Vibe 915",
  "version": 3,
  "author": "LiveWDF",
  "category": "Pedals / Modulation",
  "description": "Model 915 circuit with four staggered phase stages, paired speed controls, and transistor oscillator and lamp driver. Discharged C19 starts the oscillator. The LP1 load represents the hot lamp resistance. Current-driven optical response and thermal timing are approximated. The raw rail represents the rectified supply under load. The original 2SC539, 2SC828, and SM-150 use transistor and diode substitutes. The 100 k\u03a9 follower loads reference junction-only nodes. Source: https://schematicsonline.com/wp-content/uploads/2022/11/Univox-U-915-Uni-vibe.pdf",
  "io": {
    "inputNode": "in",
    "outputNode": "out",
    "groundNode": "0"
  },
  "layout": {
    "pots": [
      "Speed",
      "Intensity",
      "Volume",
      "Lamp Bias"
    ],
    "switches": [
      "Vibrato",
      "Cancel Sweep"
    ]
  },
