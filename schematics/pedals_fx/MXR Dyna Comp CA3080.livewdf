{
  "name": "MXR Dyna Comp CA3080",
  "version": 3,
  "author": "LiveWDF",
  "category": "Pedals / Compression",
  "description": "Vintage-style 9 V CA3080 Dyna Comp. The OTA bias diode controls a saturating differential-pair output current law. Q2 splits phase to drive the Q3/Q4 full-wave envelope detector; Q5 returns the envelope to IABC through Sensitivity. A 33 k\u03a9 load anchors Q5's emitter for the solver. OTA Balance is the internal trim. Source: https://schematicheaven.net/effects/mxr_dynacomp_compressor.pdf",
  "io": {
    "inputNode": "in",
    "outputNode": "out",
    "groundNode": "0"
  },
  "layout": {
    "pots": [
      "Sensitivity",
      "Output",
      "OTA Balance"
    ]
  },
