  ],
  "description": "Original 1176-inspired circuit approximation guided by the Cali76 FET manual. JFET gain reduction with half-drain linearization, feedback rectifier with independent attack and release, adjustable ratio, and separate uncompressed and compressed output levels. The 24 V rail span is drawn as ±12 V around signal common. Factory component values and the meter circuit are unpublished.",
  "groundNode": "0",
  "inputNode": "in",
  "layout": {
    "pots": [
      "In",
      "Out",
      "Dry",
      "Ratio",
      "Attack",
      "Release"
    ]
  },
