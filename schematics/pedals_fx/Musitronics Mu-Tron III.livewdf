{
  "author": "LiveWDF",
  "name": "Musitronics Mu-Tron III",
  "category": "Pedals / Envelope Filter",
  "description": "1975 Musitronics circuit above serial 02050. Set Low Pass and High Pass off for band-pass. Dual P873-13 photoresistors follow the same LED current, sensed across R23. R23 and unmeasured photocell curves are approximations. R_Load represents the following 1 MΩ input; two 100 kΩ shunts reference diode-only op-amp outputs for the solver. Source: https://el34world.com/charts/Schematics/Files/Effects/Mu_tron_iii_om_sch.pdf",
  "version": 3,
  "io": {
    "inputNode": "in",
    "outputNode": "out",
    "groundNode": "0"
  },
  "layout": {
    "pots": [
      "Gain",
      "Peak"
    ],
    "switches": [
      "Down Drive",
      "Low Range",
      "Low Pass",
      "High Pass",
      "Filter On"
    ]
  },
